{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "paths": {
      "@antdv-next/mobile": ["../packages/antdv-mobile/src/index.ts"],
      "@antdv-next/mobile/locale/*": ["../packages/antdv-mobile/src/locale/*"],
      "@site/*": ["./src/site/*"],
      "@mobile/*": ["./src/mobile/*"]
    },
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "plugins/**/*.ts", "vite.config.ts", "env.d.ts"]
}
