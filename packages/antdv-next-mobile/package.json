{
  "name": "antdv-next-mobile",
  "type": "module",
  "version": "0.1.0",
  "description": "Mobile UI component library for Vue 3, API-aligned with antdv-next",
  "author": {
    "email": "aibayanyu@gmail.com",
    "name": "aibayanyu20"
  },
  "license": "MIT",
  "homepage": "https://m.antdv-next.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antdv-next/antdv-next-mobile.git",
    "directory": "packages/antdv-next-mobile"
  },
  "keywords": ["vue", "vue3", "mobile", "ui", "components", "antd", "antdv-next"],
  "sideEffects": [
    "**/*.css",
    "**/style/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./global": {
      "types": "./global.d.ts"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css",
    "./locale/*": {
      "types": "./dist/locale/*.d.ts",
      "import": "./dist/locale/*.js",
      "default": "./dist/locale/*.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "global.d.ts"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "bump": "bumpp --commit \"chore(release): antdv-next-mobile %s\" --push --tag \"antdv-next-mobile@%s\"",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. packages/antdv-next-mobile"
  },
  "peerDependencies": {
    "vue": ">=3.5.0"
  },
  "dependencies": {
    "@antdv-next/icons": "catalog:prod",
    "@v-c/async-validator": "catalog:prod",
    "csstype": "catalog:prod",
    "dayjs": "catalog:prod"
  },
  "devDependencies": {
    "vite-plugin-lib-inject-css": "catalog:dev",
    "vue": "catalog:prod"
  }
}
